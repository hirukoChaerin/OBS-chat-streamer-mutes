# Copia este archivo como .env

# Clave para el overlay. Vacía = el overlay solo funciona desde tu PC (recomendado).
# Si la pones, añade &key=TU_CLAVE a las URLs del overlay en OBS.
OVERLAY_KEY=

MAX_MESSAGE_LENGTH=200
# Tiempo mínimo entre mensajes de un mismo usuario (anti-spam)
COOLDOWN_MS=1500
SESSION_TTL_HOURS=12

# Solo si usas el servicio "tunnel" de docker-compose
CF_TUNNEL_TOKEN=
